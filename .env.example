# Copy this file to .env and generate a real secret:
#   openssl rand -base64 48
# or: mix phx.gen.secret
SECRET_KEY_BASE=replace_me

# Use localhost for local Docker, or the public domain behind a TLS proxy.
PHX_HOST=localhost

# Container port. Keep REVKIT_PORT aligned with this when changing it.
PORT=4000

# SQLite file inside the container; persist /data as a volume.
DATABASE_PATH=/data/revkit.db

# Compose host binding. Keep 127.0.0.1 for local-only access; use 0.0.0.0
# only when you intentionally want LAN/public access.
REVKIT_BIND=127.0.0.1
REVKIT_PORT=4000
