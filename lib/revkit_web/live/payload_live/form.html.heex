<Layouts.app flash={@flash} current={:payloads}>
  <.header>
    {if @live_action == :new, do: "New private payload", else: "Edit your payload edition"}
    <:subtitle>
      Private editions are visible only to this browser. The public catalog is never modified.
    </:subtitle>
    <:actions>
      <.button navigate={~p"/payloads"}>Back</.button>
    </:actions>
  </.header>

  <div class="mx-auto max-w-3xl">
    <.form
      for={@form}
      id="payload-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-5"
    >
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Basics</h2>
          <.input
            field={@form[:name]}
            type="text"
            label="Name"
            maxlength={Revkit.Limits.max_name()}
          />
          <.input
            field={@form[:description]}
            type="text"
            label="When to use"
            maxlength={Revkit.Limits.max_description()}
            placeholder="e.g. Linux host with outbound TCP and bash available"
          />
          <.input field={@form[:favorite]} type="checkbox" label="Favorite this edition" />
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Template</h2>
          <.input
            field={@form[:template]}
            type="textarea"
            rows="8"
            label="Payload template"
            maxlength={Revkit.Limits.max_template()}
            class="w-full textarea font-mono text-sm"
          />
          <p class="text-xs text-base-content/60">
            Use <code class="rounded bg-base-200 px-1 font-mono">{"{{NAME}}"}</code>
            placeholders for values such as LHOST, LPORT, or a filename. Up to {Revkit.Limits.max_variables()} variables and {Revkit.Limits.max_template()} characters.
          </p>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Target assumptions</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            <.input
              field={@form[:target_os]}
              type="text"
              label="Target OS"
              maxlength={Revkit.Limits.max_target()}
              placeholder="linux, windows, macos"
            />
            <.input
              field={@form[:target_shell]}
              type="text"
              label="Target shell"
              maxlength={Revkit.Limits.max_target()}
              placeholder="bash, sh, powershell"
            />
          </div>

          <div class="fieldset mb-2">
            <label for="payload-target-tools" class="label mb-1">Target tools</label>
            <input
              id="payload-target-tools"
              type="text"
              name="payload[target_tools_text]"
              value={@target_tools}
              placeholder="base64, curl, nc"
              class="w-full input"
            />
            <p class="mt-1 text-xs text-base-content/60">
              Comma-separated, up to {Revkit.Limits.max_tools()} tools of {Revkit.Limits.max_tool_length()} characters each.
            </p>
            <p :for={error <- @form[:target_tools].errors} class="mt-1 text-sm text-error">
              {translate_error(error)}
            </p>
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Curation</h2>

          <UI.tag_picker
            id="payload-tags"
            tags={@tags}
            selected={@selected_tag_ids}
            name="payload[tags][]"
            errors={@tag_errors}
          />

          <.input
            field={@form[:notes]}
            type="textarea"
            rows="4"
            label="Context & caveats"
            maxlength={Revkit.Limits.max_notes()}
            placeholder="Authorization scope, listener expectations, cleanup, detection notes…"
          />

          <p class="text-xs text-base-content/60">
            Up to {Revkit.Limits.max_notes()} characters of context. Tags are fixed and capped at {Revkit.Limits.max_tags()} per entry.
          </p>

          <.input
            field={@form[:recipe_id]}
            type="select"
            label="Default recipe"
            prompt="No recipe"
            options={Enum.map(@recipes, &{&1.name, &1.id})}
          />
        </div>
      </section>

      <div class="sticky bottom-4 z-10 flex flex-wrap gap-2 rounded-box border border-base-300 bg-base-100/95 p-3 shadow-lg backdrop-blur">
        <button type="submit" class="btn btn-primary" phx-disable-with="Saving…">
          Save payload
        </button>
        <.button navigate={~p"/payloads"}>Cancel</.button>
      </div>
    </.form>
  </div>
</Layouts.app>
