<Layouts.app flash={@flash}>
  <.header>
    {if @live_action == :new, do: "New payload", else: "Edit payload"}
    <:subtitle>Store a template and the recipe used to transform it.</:subtitle>
    <:actions>
      <.button navigate={~p"/payloads"}>Back</.button>
    </:actions>
  </.header>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <.form
        for={@form}
        id="payload-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-4"
      >
        <.input field={@form[:name]} type="text" label="Name" />
        <.input field={@form[:description]} type="text" label="Description" />
        <.input field={@form[:favorite]} type="checkbox" label="Favorite" />

        <div class="grid gap-2 sm:grid-cols-2">
          <.input
            field={@form[:target_os]}
            type="text"
            label="Target OS"
            placeholder="linux, windows, macos"
          />
          <.input
            field={@form[:target_shell]}
            type="text"
            label="Target shell"
            placeholder="bash, sh, powershell"
          />
        </div>

        <div class="fieldset mb-2">
          <label for="payload-target-tools" class="label mb-1">Target tools</label>
          <input
            id="payload-target-tools"
            type="text"
            name="payload[target_tools_text]"
            value={@target_tools}
            placeholder="base64, curl, nc"
            class="w-full input"
          />
          <p class="mt-1 text-xs text-base-content/60">
            Comma-separated capabilities available on the target.
          </p>
        </div>

        <.input
          field={@form[:template]}
          type="textarea"
          rows="8"
          label="Template"
          class="w-full textarea font-mono text-sm"
        />

        <.input
          field={@form[:notes]}
          type="textarea"
          rows="3"
          label="Notes"
        />

        <.input
          field={@form[:recipe_id]}
          type="select"
          label="Default recipe"
          prompt="No recipe"
          options={Enum.map(@recipes, &{&1.name, &1.id})}
        />

        <div class="fieldset mb-2">
          <label for="payload-tags" class="label mb-1">Tags</label>
          <input
            id="payload-tags"
            type="text"
            name="payload[tags]"
            value={@tag_names}
            placeholder="unix, linux"
            class="w-full input"
          />
          <p class="mt-1 text-xs text-base-content/60">
            Comma-separated. Missing tags are created on save.
          </p>
        </div>

        <div class="flex gap-2">
          <button type="submit" class="btn btn-primary">Save payload</button>
          <.button navigate={~p"/payloads"}>Cancel</.button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
