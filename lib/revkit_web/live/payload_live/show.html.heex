<Layouts.app flash={@flash} current={:payloads}>
  <.header>
    <span class="break-words">{@payload.name}</span>
    <:subtitle>{@payload.description || "Payload template and target context."}</:subtitle>
    <:actions>
      <.link navigate={~p"/generate?payload_id=#{@payload.id}"} class="btn btn-primary btn-sm">
        Use in generator
      </.link>
    </:actions>
  </.header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div class="space-y-6">
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex items-center justify-between gap-2">
            <h2 class="card-title">Template</h2>
            <UI.favorite_button favorite={@payload.favorite} id={@payload.id} />
          </div>

          <UI.code_block content={@payload.template} />

          <div :if={@variables != []}>
            <p class="mb-2 text-xs font-medium text-base-content/60">Variables</p>
            <div class="flex flex-wrap gap-1">
              <span :for={name <- @variables} class="badge badge-outline font-mono">{name}</span>
            </div>
          </div>
        </div>
      </section>

      <section :if={@payload.notes} class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">Context &amp; caveats</h2>
          <p class="whitespace-pre-wrap text-sm leading-relaxed text-base-content/70">
            {@payload.notes}
          </p>
        </div>
      </section>
    </div>

    <div class="space-y-6">
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title">Target</h2>
          <UI.target_badges
            os={@payload.target_os}
            shell={@payload.target_shell}
            tools={@payload.target_tools}
          />
          <div>
            <p class="mb-2 text-xs font-medium text-base-content/60">Tags</p>
            <UI.tag_badges tags={@payload.tags} />
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h2 class="card-title">Default recipe</h2>
          <p :if={is_nil(@payload.recipe)} class="text-sm text-base-content/60">
            No default recipe. You can compose one in the generator.
          </p>
          <p :if={@payload.recipe} class="text-sm font-medium">
            {@payload.recipe.name}
          </p>
          <div :if={@chain != []} class="flex flex-wrap gap-1">
            <span
              :for={label <- @chain}
              class={[
                "badge badge-sm",
                label.known && "badge-outline",
                !label.known && "badge-warning"
              ]}
            >
              {label.label}
            </span>
          </div>
        </div>
      </section>

      <div class="flex flex-wrap gap-2">
        <.link navigate={~p"/payloads/#{@payload.id}/edit"} class="btn btn-ghost btn-sm">
          Edit
        </.link>
        <button
          type="button"
          class="btn btn-ghost btn-sm text-error"
          phx-click="delete"
          data-confirm="Delete this payload?"
        >
          Delete
        </button>
        <.link navigate={~p"/payloads"} class="btn btn-ghost btn-sm">Back to payloads</.link>
      </div>
    </div>
  </div>
</Layouts.app>
