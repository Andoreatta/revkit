<Layouts.app flash={@flash} current={:payloads}>
  <.header>
    Payloads
    <:subtitle>
      The public catalog is read-only. Improve any entry to create a private edition for this
      browser.
    </:subtitle>
    <:actions>
      <.button variant="primary" navigate={~p"/payloads/new"}>New private payload</.button>
    </:actions>
  </.header>

  <form
    id="payload-search"
    phx-change="search"
    phx-debounce="250"
    class="card mb-6 border border-base-300 bg-base-100 shadow-sm"
  >
    <div class="card-body gap-3 p-4 sm:flex-row sm:items-end">
      <label class="form-control min-w-0 flex-1">
        <span class="label-text mb-1 text-xs font-medium">Search</span>
        <input
          type="search"
          name="q"
          value={@query}
          placeholder="Name, context, or template"
          class="input input-sm w-full"
        />
      </label>

      <label class="label cursor-pointer gap-2 self-center sm:self-end sm:pb-1.5">
        <input
          type="checkbox"
          name="favorites"
          value="true"
          checked={@favorites_only}
          class="checkbox checkbox-sm checkbox-primary"
        />
        <span class="label-text text-sm">Favorites</span>
      </label>

      <label class="form-control sm:w-48">
        <span class="label-text mb-1 text-xs font-medium">Tag</span>
        <select name="tag_id" class="select select-sm w-full">
          <option value="">All tags</option>
          <option :for={tag <- @tags} value={tag.id} selected={tag.id == @tag_id}>
            {tag.name}
          </option>
        </select>
      </label>
    </div>
  </form>

  <UI.empty_state
    :if={@payloads == []}
    icon="hero-document-magnifying-glass"
    title={if @query == "", do: "No payloads yet", else: "No matching payloads"}
  >
    <:body>
      {if @query == "",
        do: "Create a private payload or load the curated catalog.",
        else: "Try a different search, tag, or clear the filters."}
    </:body>
    <:actions>
      <.button :if={@query == ""} variant="primary" navigate={~p"/payloads/new"}>
        Create payload
      </.button>
    </:actions>
  </UI.empty_state>

  <div :if={@payloads != []} class="space-y-8">
    <section class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-base font-semibold">Public catalog</h2>
        <span class="badge badge-ghost badge-sm">{length(@public_payloads)}</span>
        <span class="text-xs text-base-content/50">read-only</span>
      </div>

      <p :if={@public_payloads == []} class="text-sm text-base-content/60">
        No public payloads match these filters.
      </p>

      <div :if={@public_payloads != []} class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article
          :for={payload <- @public_payloads}
          id={"payload-card-#{payload.id}"}
          class="card border border-base-300 bg-base-100 shadow-sm"
        >
          <div class="card-body gap-3 p-5">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title text-base">
                  <.link navigate={~p"/payloads/#{payload.id}"} class="link-hover">
                    {payload.name}
                  </.link>
                </h3>
                <span class="badge badge-outline badge-sm">Public</span>
              </div>
              <p :if={payload.description} class="mt-1 text-sm text-base-content/60">
                {payload.description}
              </p>
            </div>

            <UI.target_badges
              os={payload.target_os}
              shell={payload.target_shell}
              tools={payload.target_tools}
            />

            <UI.tag_badges tags={payload.tags} />

            <p class="text-xs text-base-content/50">
              Default recipe:
              <span class="font-medium text-base-content/70">
                {if payload.recipe, do: payload.recipe.name, else: "none"}
              </span>
            </p>

            <div class="mt-auto flex flex-wrap items-center gap-1 border-t border-base-200 pt-3">
              <.link
                navigate={~p"/generate?payload_id=#{payload.id}"}
                class="btn btn-primary btn-sm"
              >
                Generate
              </.link>
              <.link navigate={~p"/payloads/#{payload.id}"} class="btn btn-ghost btn-sm">
                View
              </.link>
              <button
                type="button"
                id={"improve-payload-#{payload.id}"}
                class="btn btn-ghost btn-sm ml-auto"
                phx-click="improve"
                phx-value-id={payload.id}
              >
                Improve
              </button>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-base font-semibold">Your editions</h2>
        <span class="badge badge-ghost badge-sm">{@quota} / {Revkit.Limits.max_private_editions()}</span>
        <span class="text-xs text-base-content/50">only this browser</span>
      </div>

      <p :if={@owned_payloads == []} class="text-sm text-base-content/60">
        No private editions yet. Use Improve on a public payload, or create a new one.
      </p>

      <div :if={@owned_payloads != []} class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <article
          :for={payload <- @owned_payloads}
          id={"payload-card-#{payload.id}"}
          class="card border border-primary/30 bg-base-100 shadow-sm"
        >
          <div class="card-body gap-3 p-5">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="card-title text-base">
                    <.link navigate={~p"/payloads/#{payload.id}"} class="link-hover">
                      {payload.name}
                    </.link>
                  </h3>
                  <span class="badge badge-primary badge-sm">Your edition</span>
                </div>
                <p :if={payload.description} class="mt-1 text-sm text-base-content/60">
                  {payload.description}
                </p>
              </div>
              <UI.favorite_button favorite={payload.favorite} id={payload.id} />
            </div>

            <UI.target_badges
              os={payload.target_os}
              shell={payload.target_shell}
              tools={payload.target_tools}
            />

            <UI.tag_badges tags={payload.tags} />

            <p :if={payload.source_payload} class="text-xs text-base-content/50">
              Based on public:
              <span class="font-medium text-base-content/70">{payload.source_payload.name}</span>
            </p>

            <div class="mt-auto flex flex-wrap items-center gap-1 border-t border-base-200 pt-3">
              <.link
                navigate={~p"/generate?payload_id=#{payload.id}"}
                class="btn btn-primary btn-sm"
              >
                Generate
              </.link>
              <.link navigate={~p"/payloads/#{payload.id}"} class="btn btn-ghost btn-sm">
                View
              </.link>
              <.link navigate={~p"/payloads/#{payload.id}/edit"} class="btn btn-ghost btn-sm">
                Edit
              </.link>
              <button
                type="button"
                id={"discard-payload-#{payload.id}"}
                class="btn btn-ghost btn-sm ml-auto text-error"
                phx-click="discard"
                phx-value-id={payload.id}
                data-confirm="Discard your edition? The public original stays."
              >
                Discard
              </button>
            </div>
          </div>
        </article>
      </div>
    </section>
  </div>
</Layouts.app>
