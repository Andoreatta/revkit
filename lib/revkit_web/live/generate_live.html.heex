<Layouts.app flash={@flash} current={:generate}>
  <.header>
    Generate payload
    <:subtitle>
      Compose a template, fill variables, apply a chain, and validate before copying.
    </:subtitle>
    <:actions>
      <span class="badge badge-outline badge-sm">strings only · never executed</span>
    </:actions>
  </.header>

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
    <div class="space-y-6">
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Start from</h2>

          <form id="generate-form" phx-change="preview" phx-debounce="200" class="space-y-5">
            <div class="grid gap-3 sm:grid-cols-2">
              <.input
                type="select"
                id="generate-payload"
                name="payload_id"
                value={@payload_id}
                label="Saved payload"
                prompt="Custom template"
                options={Enum.map(@payloads, &{&1.name, &1.id})}
              />

              <.input
                type="select"
                id="generate-recipe"
                name="recipe_id"
                value={@recipe_id}
                label="Saved recipe"
                prompt="No recipe"
                options={Enum.map(@recipes, &{&1.name, &1.id})}
              />
            </div>

            <div
              :if={@target[:os] || @target[:shell] || @target[:tools] not in [nil, []]}
              class="rounded-box border border-base-300 bg-base-200/50 p-3"
            >
              <p class="mb-2 text-xs font-medium text-base-content/60">Target assumptions</p>
              <UI.target_badges
                os={@target[:os]}
                shell={@target[:shell]}
                tools={@target[:tools] || []}
              />
            </div>

            <div class="space-y-3 border-t border-base-200 pt-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-sm font-semibold">Template &amp; variables</h3>
                <span :if={@variable_names != []} class="badge badge-ghost badge-sm">
                  {length(@variable_names)} variables
                </span>
              </div>

              <.input
                type="textarea"
                id="generate-template"
                name="template"
                value={@template}
                rows="8"
                label="Payload template"
                class="w-full textarea font-mono text-sm"
              />

              <p :if={@variable_names == []} class="text-xs text-base-content/60">
                Use <code class="rounded bg-base-200 px-1 font-mono">{"{{NAME}}"}</code>
                placeholders to add variables. They appear here automatically.
              </p>

              <div :if={@variable_names != []} class="grid gap-3 sm:grid-cols-2">
                <.input
                  :for={name <- @variable_names}
                  type="text"
                  id={"generate-variable-" <> name}
                  name={"variables[#{name}]"}
                  value={@variables[name]}
                  label={name}
                  class="w-full input font-mono"
                />
              </div>
            </div>

            <div class="border-t border-base-200 pt-4">
              <StepEditor.step_editor
                steps={@steps}
                name_prefix="steps"
                id_prefix="generate"
              />
            </div>
          </form>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-3">
          <h2 class="card-title text-base">Browse catalog</h2>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <div class="mb-1 flex items-center justify-between">
                <h3 class="text-sm font-semibold">Payloads</h3>
                <.link navigate={~p"/payloads/new"} class="btn btn-ghost btn-xs">New</.link>
              </div>
              <p :if={@payloads == []} class="text-sm text-base-content/60">
                No saved payloads yet.
              </p>
              <ul :if={@payloads != []} class="menu w-full p-0">
                <li :for={payload <- @payloads}>
                  <.link navigate={~p"/generate?payload_id=#{payload.id}"} class="text-sm">
                    <span class="truncate">{payload.name}</span>
                    <span :if={payload.recipe} class="badge badge-outline badge-xs">
                      {payload.recipe.name}
                    </span>
                  </.link>
                </li>
              </ul>
            </div>

            <div>
              <div class="mb-1 flex items-center justify-between">
                <h3 class="text-sm font-semibold">Recent recipes</h3>
                <.link navigate={~p"/recipes"} class="btn btn-ghost btn-xs">All</.link>
              </div>
              <p :if={@recent_recipes == []} class="text-sm text-base-content/60">
                No saved recipes yet.
              </p>
              <ul :if={@recent_recipes != []} class="menu w-full p-0">
                <li :for={recipe <- @recent_recipes}>
                  <.link navigate={~p"/generate?recipe_id=#{recipe.id}"} class="text-sm">
                    <span class="truncate">{recipe.name}</span>
                    <span :if={recipe.favorite} class="badge badge-warning badge-xs">
                      favorite
                    </span>
                  </.link>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="space-y-6 xl:sticky xl:top-24 xl:self-start">
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">Preview</h2>
            <div class="flex flex-wrap items-center gap-1">
              <span class={[
                "badge badge-sm",
                @preview.status == :error && "badge-error",
                @preview.validation.warnings != [] && "badge-warning",
                @preview.status == :ok && @preview.validation.warnings == [] &&
                  @preview.output in [nil, ""] && "badge-ghost",
                @preview.status == :ok && @preview.validation.warnings == [] &&
                  @preview.output not in [nil, ""] && "badge-success"
              ]}>
                {cond do
                  @preview.status == :error -> "Error"
                  @preview.validation.warnings != [] -> "Warnings"
                  @preview.output in [nil, ""] -> "Idle"
                  true -> "Ready"
                end}
              </span>
              <span :if={@preview.recipe} class="badge badge-ghost badge-sm">
                {@preview.recipe.name}
              </span>
            </div>
          </div>

          <div :if={@preview.steps != []} class="flex flex-wrap gap-1">
            <span :for={{module, _options} <- @preview.steps} class="badge badge-outline badge-sm">
              {module.label()}
            </span>
          </div>

          <div :if={@preview.validation.requires != []} class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium text-base-content/60">Target requires:</span>
            <span
              :for={requirement <- @preview.validation.requires}
              class="badge badge-warning badge-sm"
            >
              {requirement.name}
            </span>
          </div>

          <div :if={@preview.validation.warnings != []} class="alert alert-error alert-soft">
            <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
            <div>
              <p class="font-semibold">Compatibility warnings</p>
              <ul class="list-inside list-disc text-sm">
                <li :for={warning <- @preview.validation.warnings}>{warning.message}</li>
              </ul>
            </div>
          </div>

          <div :if={@preview.validation.pitfalls != []} class="alert alert-warning alert-soft">
            <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
            <div>
              <p class="font-semibold">Warnings</p>
              <ul class="list-inside list-disc text-sm">
                <li :for={pitfall <- @preview.validation.pitfalls}>
                  {pitfall.message}
                  <span class="text-xs text-base-content/60">
                    ({Enum.map_join(pitfall.transforms, ", ", & &1.label())})
                  </span>
                </li>
              </ul>
            </div>
          </div>

          <div :if={@preview.error} class="alert alert-error" role="alert">
            <.icon name="hero-exclamation-circle" class="size-5 shrink-0" />
            <span>{@preview.error}</span>
          </div>

          <UI.code_block
            :if={@preview.status == :ok and @preview.output not in [nil, ""]}
            id="generate-preview"
            content={@preview.output}
            class="max-h-[28rem]"
          />

          <p
            :if={@preview.status == :ok and @preview.output in [nil, ""]}
            class="rounded-box border border-dashed border-base-300 p-6 text-center text-sm text-base-content/50"
          >
            The generated payload appears here.
          </p>

          <div class="flex items-center justify-end gap-2">
            <span id="generate-copy-status" class="sr-only" aria-live="polite"></span>
            <button
              :if={@preview.status == :ok and @preview.output not in [nil, ""]}
              type="button"
              id="generate-copy"
              phx-hook=".CopyToClipboard"
              data-copy-value={@preview.output}
              class="btn btn-primary btn-sm"
              aria-label="Copy preview to clipboard"
            >
              <.icon name="hero-clipboard" class="size-4" />
              <span data-copy-label>Copy</span>
            </button>
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Save as recipe</h2>

          <.form
            for={@save_form}
            id="save-recipe-form"
            phx-submit="save_recipe"
            class="space-y-3"
          >
            <.input field={@save_form[:name]} type="text" label="Recipe name" />
            <.input
              field={@save_form[:notes]}
              type="textarea"
              rows="3"
              label="Context & notes"
              placeholder="When to use it, decoding requirements, cleanup…"
            />
            <div class="fieldset mb-2">
              <label for="generate-recipe-tags" class="label mb-1">Tags</label>
              <input
                id="generate-recipe-tags"
                type="text"
                name="recipe[tags]"
                placeholder="linux, transport, base64"
                class="w-full input"
              />
            </div>
            <button type="submit" class="btn btn-primary w-full" phx-disable-with="Saving…">
              Save recipe
            </button>
          </.form>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>

<script :type={Phoenix.LiveView.ColocatedHook} name=".CopyToClipboard">
  export default {
    mounted() {
      this.onClick = () => this.copy()
      this.el.addEventListener("click", this.onClick)
    },

    destroyed() {
      this.el.removeEventListener("click", this.onClick)
      clearTimeout(this.feedbackTimer)
    },

    copy() {
      const value = this.el.dataset.copyValue ?? ""

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(value).then(
          () => this.feedback("Copied"),
          () => this.fallback(value)
        )
      } else {
        this.fallback(value)
      }
    },

    fallback(value) {
      const textarea = document.createElement("textarea")
      textarea.value = value
      textarea.setAttribute("readonly", "")
      textarea.style.position = "fixed"
      textarea.style.opacity = "0"
      document.body.appendChild(textarea)
      textarea.select()

      try {
        document.execCommand("copy") ? this.feedback("Copied") : this.feedback("Copy failed")
      } catch (_error) {
        this.feedback("Copy failed")
      } finally {
        textarea.remove()
      }
    },

    feedback(label) {
      const target = this.el.querySelector("[data-copy-label]")
      const status = document.getElementById("generate-copy-status")

      if (target) target.textContent = label
      if (status) status.textContent = label

      clearTimeout(this.feedbackTimer)
      this.feedbackTimer = setTimeout(() => {
        if (target) target.textContent = "Copy"
      }, 1500)
    }
  }
</script>
