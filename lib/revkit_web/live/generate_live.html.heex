<Layouts.app flash={@flash}>
  <.header>
    Generate payload
    <:subtitle>Preview a payload template through a saved transform recipe.</:subtitle>
  </.header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <div class="space-y-6">
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">Input</h2>

          <form id="generate-form" phx-change="preview" phx-debounce="200" class="space-y-4">
            <.input
              type="textarea"
              id="generate-template"
              name="template"
              value={@template}
              rows="8"
              label="Payload template"
              class="w-full textarea font-mono text-sm"
            />

            <.input
              type="select"
              id="generate-recipe"
              name="recipe_id"
              value={@recipe_id}
              label="Recipe"
              prompt="No recipe (identity)"
              options={Enum.map(@recipes, &{&1.name, &1.id})}
            />

            <p class="text-xs text-base-content/60">
              Edit the template freely. Selecting a saved payload on the left replaces it.
            </p>
          </form>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex items-center justify-between">
            <h2 class="card-title">Saved payloads</h2>
            <.link navigate={~p"/payloads/new"} class="btn btn-ghost btn-xs">New</.link>
          </div>

          <p :if={@payloads == []} class="text-sm text-base-content/60">
            No saved payloads yet.
          </p>

          <ul :if={@payloads != []} class="menu w-full">
            <li :for={payload <- @payloads}>
              <.link navigate={~p"/generate?payload_id=#{payload.id}"}>
                <span class="font-medium">{payload.name}</span>
                <span :if={payload.recipe} class="badge badge-outline badge-sm">
                  {payload.recipe.name}
                </span>
              </.link>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <div class="flex items-center justify-between">
          <h2 class="card-title">Preview</h2>
          <div class="flex items-center gap-2">
            <button
              :if={@preview.status == :ok and @preview.output != nil and @preview.output != ""}
              type="button"
              id="generate-copy"
              phx-hook=".CopyToClipboard"
              data-copy-value={@preview.output}
              class="btn btn-ghost btn-xs"
              aria-label="Copy preview to clipboard"
            >
              <.icon name="hero-clipboard" class="size-4" />
              <span data-copy-label>Copy</span>
            </button>
            <span id="generate-copy-status" class="sr-only" aria-live="polite"></span>
            <span :if={@preview.recipe} class="badge badge-ghost">
              {@preview.recipe.name}
            </span>
          </div>
        </div>

        <div :if={@preview.steps != []} class="flex flex-wrap gap-2">
          <span :for={{module, _options} <- @preview.steps} class="badge badge-outline">
            {module.label()}
          </span>
        </div>

        <div :if={@preview.validation.requires != []} class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-medium text-base-content/60">Target requires:</span>
          <span
            :for={requirement <- @preview.validation.requires}
            class="badge badge-warning badge-sm"
          >
            {requirement.name}
          </span>
        </div>

        <div :if={@preview.validation.pitfalls != []} class="alert alert-warning">
          <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
          <div>
            <p class="font-semibold">Warnings</p>
            <ul class="list-inside list-disc text-sm">
              <li :for={pitfall <- @preview.validation.pitfalls}>
                {pitfall.message}
                <span class="text-xs text-base-content/60">
                  ({Enum.map_join(pitfall.transforms, ", ", & &1.label())})
                </span>
              </li>
            </ul>
          </div>
        </div>

        <div :if={@preview.error} class="alert alert-error" role="alert">
          <.icon name="hero-exclamation-circle" class="size-5 shrink-0" />
          <span>{@preview.error}</span>
        </div>

        <pre
          :if={@preview.status == :ok}
          id="generate-preview"
          class="max-h-[28rem] overflow-auto whitespace-pre-wrap break-all rounded-box bg-base-200 p-4 font-mono text-sm"
        >{@preview.output}</pre>
      </div>
    </div>
  </div>
</Layouts.app>

<script :type={Phoenix.LiveView.ColocatedHook} name=".CopyToClipboard">
  export default {
    mounted() {
      this.onClick = () => this.copy()
      this.el.addEventListener("click", this.onClick)
    },

    destroyed() {
      this.el.removeEventListener("click", this.onClick)
      clearTimeout(this.feedbackTimer)
    },

    copy() {
      const value = this.el.dataset.copyValue ?? ""

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(value).then(
          () => this.feedback("Copied"),
          () => this.fallback(value)
        )
      } else {
        this.fallback(value)
      }
    },

    fallback(value) {
      const textarea = document.createElement("textarea")
      textarea.value = value
      textarea.setAttribute("readonly", "")
      textarea.style.position = "fixed"
      textarea.style.opacity = "0"
      document.body.appendChild(textarea)
      textarea.select()

      try {
        document.execCommand("copy") ? this.feedback("Copied") : this.feedback("Copy failed")
      } catch (_error) {
        this.feedback("Copy failed")
      } finally {
        textarea.remove()
      }
    },

    feedback(label) {
      const target = this.el.querySelector("[data-copy-label]")
      const status = document.getElementById("generate-copy-status")

      if (target) target.textContent = label
      if (status) status.textContent = label

      clearTimeout(this.feedbackTimer)
      this.feedbackTimer = setTimeout(() => {
        if (target) target.textContent = "Copy"
      }, 1500)
    }
  }
</script>
