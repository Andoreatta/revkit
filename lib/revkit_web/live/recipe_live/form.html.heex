<Layouts.app flash={@flash}>
  <.header>
    {if @live_action == :new, do: "New recipe", else: "Edit recipe"}
    <:subtitle>Transforms run from top to bottom.</:subtitle>
    <:actions>
      <.button navigate={~p"/recipes"}>Back</.button>
    </:actions>
  </.header>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <.form
        for={@form}
        id="recipe-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-4"
      >
        <.input field={@form[:name]} type="text" label="Name" />
        <.input field={@form[:description]} type="text" label="Description" />
        <.input field={@form[:favorite]} type="checkbox" label="Favorite" />

        <.input
          field={@form[:template]}
          type="textarea"
          rows="6"
          label="Template snapshot"
          class="w-full textarea font-mono text-sm"
        />

        <.input field={@form[:notes]} type="textarea" rows="3" label="Notes" />

        <div class="fieldset mb-2">
          <label for="recipe-tags" class="label mb-1">Tags</label>
          <input
            id="recipe-tags"
            type="text"
            name="recipe[tags]"
            value={@tag_names}
            placeholder="unix, reverse-shell"
            class="w-full input"
          />
          <p class="mt-1 text-xs text-base-content/60">
            Comma-separated. Missing tags are created on save.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold">Transform chain</h2>
            <button
              type="button"
              id="recipe-add-step"
              class="btn btn-ghost btn-sm"
              phx-click="add_step"
            >
              <.icon name="hero-plus" class="size-4" /> Add transform
            </button>
          </div>

          <p :if={@steps == []} class="text-sm text-base-content/60">
            No transforms yet. The payload passes through unchanged.
          </p>

          <div
            :for={{step, index} <- Enum.with_index(@steps)}
            id={"recipe-step-#{index}"}
            class="flex flex-col gap-2 rounded-box bg-base-200 p-3 sm:flex-row sm:items-center"
          >
            <select
              name={"recipe[steps][#{index}][key]"}
              class="w-full select select-sm sm:flex-1"
            >
              <option value="">Select a transform</option>
              <option
                :if={step.key != "" and is_nil(Transforms.fetch(step.key))}
                value={step.key}
                selected
              >
                {step.key} (unknown)
              </option>
              <option
                :for={transform <- Transforms.all()}
                value={transform.key()}
                selected={step.key == Atom.to_string(transform.key())}
              >
                {transform.label()}
              </option>
            </select>

            <div class="flex gap-1">
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                phx-click="move_step"
                phx-value-id={step.id}
                phx-value-direction="up"
                aria-label="Move up"
              >
                <.icon name="hero-arrow-up" class="size-4" />
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-xs"
                phx-click="move_step"
                phx-value-id={step.id}
                phx-value-direction="down"
                aria-label="Move down"
              >
                <.icon name="hero-arrow-down" class="size-4" />
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-xs text-error"
                phx-click="remove_step"
                phx-value-id={step.id}
                aria-label="Remove step"
              >
                <.icon name="hero-x-mark" class="size-4" />
              </button>
            </div>
          </div>

          <p :for={error <- @form[:steps].errors} class="text-sm text-error">
            {translate_error(error)}
          </p>
        </div>

        <div class="flex gap-2">
          <button type="submit" class="btn btn-primary">Save recipe</button>
          <.button navigate={~p"/recipes"}>Cancel</.button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
