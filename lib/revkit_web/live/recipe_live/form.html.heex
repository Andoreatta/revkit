<Layouts.app flash={@flash}>
  <.header>
    {if @live_action == :new, do: "New recipe", else: "Edit recipe"}
    <:subtitle>Transforms run from top to bottom.</:subtitle>
    <:actions>
      <.button navigate={~p"/recipes"}>Back</.button>
    </:actions>
  </.header>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <.form
        for={@form}
        id="recipe-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-4"
      >
        <.input field={@form[:name]} type="text" label="Name" />
        <.input field={@form[:description]} type="text" label="Description" />
        <.input field={@form[:favorite]} type="checkbox" label="Favorite" />

        <.input
          field={@form[:template]}
          type="textarea"
          rows="6"
          label="Template snapshot"
          class="w-full textarea font-mono text-sm"
        />

        <.input field={@form[:notes]} type="textarea" rows="3" label="Notes" />

        <div class="grid gap-2 sm:grid-cols-2">
          <.input
            field={@form[:target_os]}
            type="text"
            label="Target OS"
            placeholder="linux, windows, macos"
          />
          <.input
            field={@form[:target_shell]}
            type="text"
            label="Target shell"
            placeholder="bash, sh, powershell"
          />
        </div>

        <div class="fieldset mb-2">
          <label for="recipe-target-tools" class="label mb-1">Target tools</label>
          <input
            id="recipe-target-tools"
            type="text"
            name="recipe[target_tools_text]"
            value={@target_tools}
            placeholder="base64, curl, nc"
            class="w-full input"
          />
        </div>

        <div class="fieldset mb-2">
          <label for="recipe-tags" class="label mb-1">Tags</label>
          <input
            id="recipe-tags"
            type="text"
            name="recipe[tags]"
            value={@tag_names}
            placeholder="unix, reverse-shell"
            class="w-full input"
          />
          <p class="mt-1 text-xs text-base-content/60">
            Comma-separated. Missing tags are created on save.
          </p>
        </div>

        <StepEditor.step_editor
          steps={@steps}
          name_prefix="recipe[steps]"
          id_prefix="recipe"
          errors={@form[:steps].errors}
        />

        <div class="flex gap-2">
          <button type="submit" class="btn btn-primary">Save recipe</button>
          <.button navigate={~p"/recipes"}>Cancel</.button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
