<Layouts.app flash={@flash} current={:recipes}>
  <.header>
    {if @live_action == :new, do: "New recipe", else: "Edit recipe"}
    <:subtitle>Snapshot metadata, target assumptions, and the ordered chain.</:subtitle>
    <:actions>
      <.button navigate={~p"/recipes"}>Back</.button>
    </:actions>
  </.header>

  <div class="mx-auto max-w-3xl">
    <.form
      for={@form}
      id="recipe-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-5"
    >
      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Basics</h2>
          <.input field={@form[:name]} type="text" label="Name" />
          <.input
            field={@form[:description]}
            type="text"
            label="When to use"
            placeholder="e.g. Transport an encoded Bash TCP payload"
          />
          <.input field={@form[:favorite]} type="checkbox" label="Favorite" />
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">Template snapshot</h2>
            <.link
              :if={@live_action == :edit}
              navigate={~p"/generate?recipe_id=#{@recipe.id}"}
              class="btn btn-ghost btn-xs"
            >
              Edit variables in generator
            </.link>
          </div>
          <.input
            field={@form[:template]}
            type="textarea"
            rows="6"
            label="Payload template"
            class="w-full textarea font-mono text-sm"
          />
          <p class="text-xs text-base-content/60">
            The saved variable values are preserved. Use the generator to edit variables and
            test the chain.
          </p>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Target assumptions</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            <.input
              field={@form[:target_os]}
              type="text"
              label="Target OS"
              placeholder="linux, windows, macos"
            />
            <.input
              field={@form[:target_shell]}
              type="text"
              label="Target shell"
              placeholder="bash, sh, powershell"
            />
          </div>

          <div class="fieldset mb-2">
            <label for="recipe-target-tools" class="label mb-1">Target tools</label>
            <input
              id="recipe-target-tools"
              type="text"
              name="recipe[target_tools_text]"
              value={@target_tools}
              placeholder="base64, curl, nc"
              class="w-full input"
            />
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Curation</h2>
          <div class="fieldset mb-2">
            <label for="recipe-tags" class="label mb-1">Tags</label>
            <input
              id="recipe-tags"
              type="text"
              name="recipe[tags]"
              value={@tag_names}
              placeholder="linux, transport, base64"
              class="w-full input"
            />
            <p class="mt-1 text-xs text-base-content/60">
              Comma-separated. Missing tags are created on save.
            </p>
          </div>

          <.input
            field={@form[:notes]}
            type="textarea"
            rows="4"
            label="Context & caveats"
            placeholder="When to use it, decoding requirements, cleanup, detection notes…"
          />
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-4">
          <h2 class="card-title text-base">Transform chain</h2>
          <StepEditor.step_editor
            steps={@steps}
            name_prefix="recipe[steps]"
            id_prefix="recipe"
            errors={@form[:steps].errors}
          />
        </div>
      </section>

      <div class="sticky bottom-4 z-10 flex flex-wrap gap-2 rounded-box border border-base-300 bg-base-100/95 p-3 shadow-lg backdrop-blur">
        <button type="submit" class="btn btn-primary" phx-disable-with="Saving…">
          Save recipe
        </button>
        <.button navigate={~p"/recipes"}>Cancel</.button>
      </div>
    </.form>
  </div>
</Layouts.app>
