<Layouts.app flash={@flash} current={:recipes}>
  <.header>
    Recipes
    <:subtitle>Saved generation snapshots: template, variables, chain, and context.</:subtitle>
    <:actions>
      <.button variant="primary" navigate={~p"/generate"}>New recipe</.button>
    </:actions>
  </.header>

  <form
    id="recipe-search"
    phx-change="search"
    phx-debounce="250"
    class="card mb-6 border border-base-300 bg-base-100 shadow-sm"
  >
    <div class="card-body gap-3 p-4 sm:flex-row sm:items-end">
      <label class="form-control min-w-0 flex-1">
        <span class="label-text mb-1 text-xs font-medium">Search</span>
        <input
          type="search"
          name="q"
          value={@query}
          placeholder="Name, template, context, or notes"
          class="input input-sm w-full"
        />
      </label>

      <label class="label cursor-pointer gap-2 self-center sm:self-end sm:pb-1.5">
        <input
          type="checkbox"
          name="favorites"
          value="true"
          checked={@favorites_only}
          class="checkbox checkbox-sm checkbox-primary"
        />
        <span class="label-text text-sm">Favorites</span>
      </label>

      <label class="form-control sm:w-48">
        <span class="label-text mb-1 text-xs font-medium">Tag</span>
        <select name="tag_id" class="select select-sm w-full">
          <option value="">All tags</option>
          <option :for={tag <- @tags} value={tag.id} selected={tag.id == @tag_id}>
            {tag.name}
          </option>
        </select>
      </label>
    </div>
  </form>

  <p class="mb-3 text-xs text-base-content/50">
    {length(@recipes)} {if length(@recipes) == 1, do: "recipe", else: "recipes"}
  </p>

  <UI.empty_state
    :if={@recipes == []}
    icon="hero-rectangle-stack"
    title={if @query == "", do: "No recipes yet", else: "No matching recipes"}
  >
    <:body>
      {if @query == "",
        do: "Compose a payload in the generator and save the complete snapshot here.",
        else: "Try a different search, tag, or clear the filters."}
    </:body>
    <:actions>
      <.button :if={@query == ""} variant="primary" navigate={~p"/generate"}>
        Open generator
      </.button>
    </:actions>
  </UI.empty_state>

  <div :if={@recipes != []} class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <article
      :for={recipe <- @recipes}
      id={"recipe-card-#{recipe.id}"}
      class="card border border-base-300 bg-base-100 shadow-sm"
    >
      <div class="card-body gap-3 p-5">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <h2 class="card-title text-base">
              <.link navigate={~p"/recipes/#{recipe.id}"} class="link-hover">
                {recipe.name}
              </.link>
            </h2>
            <p :if={recipe.description} class="mt-1 text-sm text-base-content/60">
              {recipe.description}
            </p>
          </div>
          <UI.favorite_button favorite={recipe.favorite} id={recipe.id} />
        </div>

        <pre class="max-h-20 overflow-hidden whitespace-pre-wrap break-all rounded-box bg-base-200 px-3 py-2 font-mono text-xs text-base-content/70">{recipe.template}</pre>

        <div :if={@chains[recipe.id] != []} class="flex flex-wrap gap-1">
          <span
            :for={label <- @chains[recipe.id]}
            class={[
              "badge badge-sm",
              label.known && "badge-outline",
              !label.known && "badge-warning"
            ]}
          >
            {label.label}
          </span>
        </div>

        <UI.target_badges
          os={recipe.target_os}
          shell={recipe.target_shell}
          tools={recipe.target_tools}
        />

        <UI.tag_badges tags={recipe.tags} />

        <div class="mt-auto flex flex-wrap items-center gap-1 border-t border-base-200 pt-3">
          <.link navigate={~p"/generate?recipe_id=#{recipe.id}"} class="btn btn-primary btn-sm">
            Open
          </.link>
          <.link navigate={~p"/recipes/#{recipe.id}"} class="btn btn-ghost btn-sm">
            View
          </.link>
          <button
            type="button"
            class="btn btn-ghost btn-sm"
            phx-click="fork"
            phx-value-id={recipe.id}
            data-confirm="Fork this recipe?"
          >
            Fork
          </button>
          <.link navigate={~p"/recipes/#{recipe.id}/edit"} class="btn btn-ghost btn-sm">
            Edit
          </.link>
          <button
            type="button"
            class="btn btn-ghost btn-sm ml-auto text-error"
            phx-click="delete"
            phx-value-id={recipe.id}
            data-confirm="Delete this recipe?"
          >
            Delete
          </button>
        </div>
      </div>
    </article>
  </div>
</Layouts.app>
