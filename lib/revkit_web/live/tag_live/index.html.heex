<Layouts.app flash={@flash} current={:tags}>
  <.header>
    Tags
    <:subtitle>
      A fixed vocabulary shared by the public catalog and every private edition.
    </:subtitle>
    <:actions>
      <span class="badge badge-outline badge-sm">
        {length(@tags)} / {Revkit.Limits.max_tag_vocabulary()} tags
      </span>
    </:actions>
  </.header>

  <div class="mx-auto max-w-3xl space-y-6">
    <div class="rounded-box border border-base-300 bg-base-100 p-4 text-sm text-base-content/70 shadow-sm">
      <p>
        Tags are read-only and capped at {Revkit.Limits.max_tag_vocabulary()} entries. Each
        payload or recipe may use up to {Revkit.Limits.max_tags()} tags.
      </p>
    </div>

    <UI.empty_state :if={@tags == []} icon="hero-tag" title="No tags yet">
      <:body>The vocabulary is loaded with the curated catalog.</:body>
    </UI.empty_state>

    <div :if={@tags != []} class="grid gap-3 sm:grid-cols-2">
      <div :for={entry <- @tags} class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body gap-2 p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="badge badge-ghost">{entry.tag.name}</span>
            <span class="text-xs text-base-content/50">
              {entry.payloads} payloads · {entry.recipes} recipes
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
