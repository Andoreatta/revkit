<Layouts.app flash={@flash}>
  <.header>
    Tags
    <:subtitle>Curation labels shared by payloads and recipes.</:subtitle>
  </.header>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <h2 class="card-title">New tag</h2>
      <.form for={@new_form} id="new-tag-form" phx-submit="create" class="flex gap-2">
        <.input field={@new_form[:name]} type="text" label="Name" class="w-full input" />
        <button type="submit" class="btn btn-primary self-end">Create</button>
      </.form>
    </div>
  </div>

  <div :if={@tags == []} class="card bg-base-100 shadow-sm">
    <div class="card-body items-center text-center">
      <p class="text-base-content/70">No tags yet.</p>
    </div>
  </div>

  <.table :if={@tags != []} id="tags" rows={@tags}>
    <:col :let={tag} label="Name">
      <form
        id={"rename-tag-#{tag.id}"}
        phx-submit="rename"
        class="flex gap-2"
      >
        <input type="hidden" name="tag_id" value={tag.id} />
        <input type="text" name="tag[name]" value={tag.name} class="input input-sm" />
        <button type="submit" class="btn btn-ghost btn-xs">Rename</button>
      </form>
    </:col>
    <:action :let={tag}>
      <button
        type="button"
        class="btn btn-ghost btn-xs text-error"
        phx-click="delete"
        phx-value-id={tag.id}
        data-confirm="Delete this tag from all payloads and recipes?"
      >
        Delete
      </button>
    </:action>
  </.table>
</Layouts.app>
